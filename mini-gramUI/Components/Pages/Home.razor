
@page "/"
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<Home> Logger
@using mini_gramUI.Services
@inject ApiClientService ApiClientService


@rendermode InteractiveServer


<div class="bilder-header">
    <div class="rubrik">
        <h2>Galleri</h2>
        <p class="galleri-text">
            Upptäck bilder från MinGram
        </p>
        @if (roll == "Betraktare")
        {
            <p class="login-text">
                Logga in för att ladda upp bilder.
            </p>
        }
    </div>

    @if (roll == "Betraktare")
    {
        <button class="loginknapp"
                @onclick="OppnaLoginModal">
            Logga in
        </button>
    }


    @if (roll == "Fotograf" || roll == "Admin")
    {
        <div class="inloggad-knappar">

            <button class="laggtillknapp"
                    @onclick="OppnaModal">
                + Ladda upp bild
            </button>

            <button class="loginknapp"
                    @onclick="LoggaUt">
                Logga ut
            </button>

        </div>
    }
    

</div>



@if (laddar)
{
    <p>Hämtar bilder...</p>
}
else if (bilder.Count == 0)
{
    <p>Inga bilder ännu. Ladda upp den första!</p>
}
else
{
    <div class="bildgalleri">
        @foreach (var bild in bilder)
        {
            <div class="bildkort">

                <img src="@bild.TidsbegransadUrl"
                     alt="@bild.Caption" />

                <div class="bildinfo">

                    <p class="caption">
                        @bild.Caption
                    </p>

                    <p class="taggar">
                        @string.Join(" ", bild.Taggar.Select(t => $"#{t}"))
                    </p>

                    @if (roll == "Admin")
                    {
                        <button class="raderaknapp"
                                @onclick="() => RaderaBild(bild.Namn)">
                            🗑
                        </button>
                    }

                </div>

            </div>
        }

    </div>

   
}

@if (!string.IsNullOrEmpty(felmeddelande))
{
    <p class="fel">@felmeddelande</p>
}

<UploadBildModal Visa="@visaModal"
                 Roll="@roll"
                 OnStang="StangModal"
                 OnUppladdad="BildUppladdad" />

<LoginModal Visa="@visaLoginModal"
            OnStang="StangLoginModal"
            OnLogin="LoggaIn" />

@code {

    private List<Bild> bilder = new();

    private bool laddar = true;
    private bool visaModal = false;
    private bool visaLoginModal = false;

    private string felmeddelande = "";
    private string roll = "Betraktare";

    private void LoggaUt()
    {
        roll = "Betraktare";
    }

    protected override async Task OnInitializedAsync()
    {
        await HamtaRoll();
        await HamtaBilder();
    }

    private async Task HamtaRoll()
    {
        var client = HttpClientFactory.CreateClient("MinGramApi");

        var response =
            await client.GetFromJsonAsync<RollResponse>("roll");

        roll = response?.Roll ?? "Betraktare";
    }


    private async Task HamtaBilder()
    {
        laddar = true;
        felmeddelande = "";

        try
        {
            var client = HttpClientFactory.CreateClient("MinGramApi");

            bilder = await client.GetFromJsonAsync<List<Bild>>("bilder")
                     ?? new List<Bild>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kunde inte hämta bilder");

            felmeddelande =
                "Kunde inte hämta bilder från API:t.";
        }
        finally
        {
            laddar = false;
        }
    }

    private void OppnaModal()
    {
        visaModal = true;
    }
    private void StangModal()
    {
        visaModal = false;
    }
    private void OppnaLoginModal()
    {
        visaLoginModal = true;
    }
    private void StangLoginModal()
    {
        visaLoginModal = false;
    }

    private void LoggaIn(string valdRoll)
    {
        roll = valdRoll;
        visaLoginModal = false;
    }

    private async Task BildUppladdad()
    {
        visaModal = false;
        await HamtaBilder();
    }


    private async Task RaderaBild(string namn)
    {
        var client = ApiClientService.SkapaClientMedRoll(roll);

        var response = await client.DeleteAsync(
            $"bilder/{Uri.EscapeDataString(namn)}"
        );

        if (!response.IsSuccessStatusCode)
        {
            felmeddelande =
                $"Kunde inte ta bort bilden. Status: {response.StatusCode}";

            return;
        }

        felmeddelande = "";

        await HamtaBilder();
    }

    private record Bild(
        string Namn,
        string Caption,
        List<string> Taggar,
        string Url,
        string TidsbegransadUrl
    );

    private record RollResponse(
        string Roll
);

}