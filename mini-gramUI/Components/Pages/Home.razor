@* Home.razor — startsidan för MinGram
   En Blazor-komponent: HTML, C# och CSS i samma fil.

   Ny på Blazor? Läs igenom introduktionen först:
   → 35_natverk_sakerhet/notes/blazor_intro.md

   Din uppgift är att implementera de metoder som är markerade med TODO.
   Strukturen är klar — du fyller i HTTP-anropen mot ditt eget API. *@

@page "/"
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<Home> Logger

@* InteractiveServer = C#-koden körs på servern, UI uppdateras via WebSocket (SignalR).
   React-jämförelse: det finns ingen direkt motsvarighet — närmast är Next.js Server Components,
   men Blazor håller en live-anslutning öppen till servern istället för att rendera en gång. *@
@rendermode InteractiveServer


<div class="bilder-header">
    <div class="rubrik">
        <h2>Galleri</h2>
        <p class="galleri-text">
            Upptäck bilder från MinGram
        </p>
    </div>

    <button class="laggtillknapp" @onclick="OppnaModal">
        + Ladda upp bild
    </button>
</div>


@if (laddar)
{
    <p>Hämtar bilder...</p>
}
else if (bilder.Count == 0)
{
    <p>Inga bilder ännu. Ladda upp den första!</p>
}
else
{
    <div class="bildgalleri">

        @* @foreach loopar och renderar ett element per item — som .map() i React/JSX *@
        @foreach (var bild in bilder)
        {
            <div class="bildkort">

                <img src="@bild.TidsbegransadUrl"
                     alt="@bild.Caption" />

                <div class="bildinfo">

                    <p class="caption">
                        @bild.Caption
                    </p>

                    <p class="taggar">
                        @string.Join(" · ", bild.Taggar.Select(t => $"#{t}"))
                    </p>

                    @* @onclick = onClick i React. Lambda med () => gör att vi kan skicka med argument. *@
                    <button class="raderaknapp"
                            @onclick="() => RaderaBild(bild.Namn)">
                        🗑
                    </button>

                </div>

            </div>
        }

    </div>

   
}


@if (!string.IsNullOrEmpty(felmeddelande))
{
    <p class="fel">@felmeddelande</p>
}


@* UploadBildModal är en separat Blazor-komponent.
   Visa styr om popupen är öppen.
   OnStang körs när användaren stänger popupen.
   OnUppladdad körs när en bild har laddats upp,
   då hämtar vi bilderna igen så galleriet uppdateras. *@
<UploadBildModal Visa="@visaModal"
                 OnStang="StangModal"
                 OnUppladdad="BildUppladdad" />



@code {

    private List<Bild> bilder = new();

    private bool laddar = true;

    // Styr om UploadBildModal ska visas eller inte
    private bool visaModal = false;

    private string felmeddelande = "";


    // OnInitializedAsync = useEffect(() => { fetchData() }, []) i React
    // Körs en gång när komponenten mountas. Asynkron, så du kan awaita direkt.
    protected override async Task OnInitializedAsync()
    {
        await HamtaBilder();
    }


    private async Task HamtaBilder()
    {
        laddar = true;
        felmeddelande = "";

        try
        {
            var client = HttpClientFactory.CreateClient("MinGramApi");

            bilder = await client.GetFromJsonAsync<List<Bild>>("bilder")
                     ?? new List<Bild>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kunde inte hämta bilder");

            felmeddelande =
                "Kunde inte hämta bilder från API:t.";
        }
        finally
        {
            laddar = false;
        }
    }


    // Öppnar popupen för uppladdning
    private void OppnaModal()
    {
        visaModal = true;
    }


    // Stänger popupen
    private void StangModal()
    {
        visaModal = false;
    }


    // Körs från UploadBildModal när en bild har laddats upp.
    // Då stänger vi popupen och hämtar listan igen.
    private async Task BildUppladdad()
    {
        visaModal = false;

        await HamtaBilder();
    }


    private async Task RaderaBild(string namn)
    {
        // TODO: Anropa DELETE /bilder/{namn} på ditt API
        // Tips: Anropa HamtaBilder() efteråt så försvinner bilden från listan

        felmeddelande =
            "⚠️ Metoden är inte implementerad än — implementera DELETE /bilder/{namn}";
    }


    // Datamodell som matchar JSON-svaret från MinGram-API:t
    private record Bild(
        string Namn,
        string Caption,
        List<string> Taggar,
        string Url,
        string TidsbegransadUrl
    );
}